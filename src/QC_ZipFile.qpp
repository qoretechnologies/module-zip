#include "QC_ZipFile.h"
#include "QoreZipFile.h"
#include "ZipInputStream.h"
#include "ZipOutputStream.h"
#include "QC_ZipInputStream.h"
#include "QC_ZipOutputStream.h"

/** @defgroup zip_compression_methods Zip Compression Methods
    These constants define the compression methods available for ZIP archives.
*/
///@{
//! No compression (store only)
const ZIP_CM_STORE = MZ_COMPRESS_METHOD_STORE;

//! Deflate compression (standard, most compatible)
const ZIP_CM_DEFLATE = MZ_COMPRESS_METHOD_DEFLATE;

//! BZip2 compression
const ZIP_CM_BZIP2 = MZ_COMPRESS_METHOD_BZIP2;

//! LZMA compression
const ZIP_CM_LZMA = MZ_COMPRESS_METHOD_LZMA;

//! Zstandard compression (fast, high ratio)
const ZIP_CM_ZSTD = MZ_COMPRESS_METHOD_ZSTD;

//! XZ/LZMA2 compression
const ZIP_CM_XZ = MZ_COMPRESS_METHOD_XZ;
///@}

/** @defgroup zip_compression_levels Zip Compression Levels
    These constants define compression levels for ZIP archives.
*/
///@{
//! Default compression level
const ZIP_COMPRESSION_DEFAULT = -1;

//! No compression (store only)
const ZIP_COMPRESSION_STORE = 0;

//! Fastest compression
const ZIP_COMPRESSION_FASTEST = 1;

//! Best (maximum) compression
const ZIP_COMPRESSION_BEST = 9;
///@}

/** @defgroup zip_encryption_methods Zip Encryption Methods
    These constants define encryption methods for ZIP archives.
*/
///@{
//! No encryption
const ZIP_EM_NONE = 0;

//! Traditional PKWARE encryption (weak, not recommended)
const ZIP_EM_TRAD_PKWARE = 1;

//! AES-128 encryption
const ZIP_EM_AES_128 = 0x0101;

//! AES-192 encryption
const ZIP_EM_AES_192 = 0x0102;

//! AES-256 encryption (recommended)
const ZIP_EM_AES_256 = 0x0103;
///@}

//! Information about a ZIP archive entry
/** @since %zip 1.0
*/
hashdecl Qore::Zip::ZipEntryInfo {
    //! The name/path of the entry within the archive
    string name;

    //! The uncompressed size of the entry in bytes
    int size;

    //! The compressed size of the entry in bytes
    int compressed_size;

    //! The last modification date and time of the entry
    date modified;

    //! The CRC-32 checksum of the uncompressed data
    int crc32;

    //! The compression method used (one of @ref zip_compression_methods)
    int compression_method;

    //! True if this entry represents a directory
    bool is_directory;

    //! True if this entry is password-protected
    bool is_encrypted;

    //! The encryption method used (one of @ref zip_encryption_methods), or 0 if not encrypted
    /** @since %zip 1.1
    */
    int encryption_method;

    //! True if this entry is a symbolic link
    /** @since %zip 1.1
    */
    bool is_symlink;

    //! Unix file permissions (e.g., 0644, 0755), or -1 if not available
    /** Only set for entries created on Unix or macOS systems.

        @since %zip 1.1
    */
    int permissions;

    //! The operating system that created this entry
    /** Common values: 0 = DOS/Windows, 3 = Unix, 10 = Windows NTFS, 19 = macOS

        @since %zip 1.1
    */
    int created_by_system;

    //! Symlink target path (only set for symlink entries)
    /** @since %zip 1.1
    */
    *string link_target;

    //! Optional comment associated with this entry
    *string comment;
}

//! Options for adding entries to a ZIP archive
/** @since %zip 1.0
*/
hashdecl Qore::Zip::ZipAddOptions {
    //! Compression level (0-9, where 0=store, 9=maximum)
    *int compression_level;

    //! Compression method (one of @ref zip_compression_methods)
    *int compression_method;

    //! Password for encryption (enables AES-256 by default)
    *string password;

    //! Optional comment for the entry
    *string comment;

    //! Last modification time (defaults to current time)
    *date modified;

    //! Encryption method (one of @ref zip_encryption_methods)
    /** If not set, defaults to AES-256 when a password is provided.
        Use \c ZIP_EM_TRAD_PKWARE for legacy PKWARE encryption, or
        \c ZIP_EM_NONE to disable encryption even with a password.

        @note AES-128 and AES-192 are only supported for in-memory data entries
        (via add() or data provider). The addFile() method always uses AES-256.

        @since %zip 1.1
    */
    *int encryption_method;
}

//! Result of verifying a single archive entry
/** @since %zip 1.1
*/
hashdecl Qore::Zip::ZipVerifyResult {
    //! The name/path of the entry
    string name;

    //! True if the entry passed integrity verification
    bool valid;

    //! Error message if verification failed, or NOTHING if valid
    *string error;
}

//! Result of comparing two ZIP archives
/** @since %zip 1.1
*/
hashdecl Qore::Zip::ZipDiffResult {
    //! Entries present only in the second archive
    list<hash<ZipEntryInfo>> added;

    //! Entries present only in the first archive
    list<hash<ZipEntryInfo>> deleted;

    //! Entries present in both archives with different content (CRC32 mismatch)
    /** Each element is a hash with \c "old" and \c "new" keys containing ZipEntryInfo hashes.
    */
    list<hash<auto>> modified;

    //! Entries present in both archives with identical content
    list<hash<ZipEntryInfo>> unchanged;

    //! Count of entries only in the second archive
    int added_count;

    //! Count of entries only in the first archive
    int deleted_count;

    //! Count of entries with different content
    int modified_count;

    //! Count of entries with identical content
    int unchanged_count;
}

//! Options for extracting entries from a ZIP archive
/** @since %zip 1.0
*/
hashdecl Qore::Zip::ZipExtractOptions {
    //! Password for decryption (required for encrypted entries)
    *string password;

    //! If True, overwrite existing files during extraction (default: False)
    *bool overwrite;

    //! If True, preserve directory paths during extraction (default: True)
    /** When False, all entries are extracted as flat files in the destination directory
        (directory components are stripped from entry names).
    */
    *bool preserve_paths;

    //! Strip this prefix from entry paths during extraction
    /** If set, entries whose names start with this prefix will have it removed.
        For example, with \c strip_prefix = \c "src/", the entry \c "src/main.cpp"
        would be extracted as \c "main.cpp".
    */
    *string strip_prefix;

    //! Add this prefix to entry paths during extraction
    /** If set, this prefix is prepended to all entry names.
        For example, with \c add_prefix = \c "output/", the entry \c "main.cpp"
        would be extracted as \c "output/main.cpp".
    */
    *string add_prefix;

    //! If True, allow symlink entries to be extracted (default: False)
    /** Symlinks in archives are a security risk as they can point outside the
        destination directory. By default, symlink entries are silently skipped
        during extraction. Set to \c True to allow symlink extraction (targets
        are still validated to stay within the destination directory).

        @since %zip 1.1
    */
    *bool allow_symlinks;

    //! Optional callback called for each entry being extracted
    /** The callback receives the entry name as a string argument.

        @par Example:
        @code{.py}
        zip.extractAll("/dest", {"entry_callback": sub (string name) { printf("Extracting: %s\n", name); }});
        @endcode

        @since %zip 1.1
    */
    *code<nothing(string)> entry_callback;
}

//! The ZipFile class provides functionality for creating, reading, and modifying ZIP archives
/**
    @par Example: Creating a ZIP archive
    @code{.py}
#!/usr/bin/qore

%requires zip

ZipFile zip("archive.zip", "w");
zip.addText("readme.txt", "Hello, World!");
zip.addFile("document.pdf", "/path/to/document.pdf");
zip.addDirectory("images/");
zip.close();
    @endcode

    @par Example: Reading a ZIP archive
    @code{.py}
ZipFile zip("archive.zip", "r");
foreach hash<Qore::Zip::ZipEntryInfo> entry in (zip.entries()) {
    printf("Entry: %s, Size: %d bytes\n", entry.name, entry.size);
}
binary data = zip.read("readme.txt");
zip.close();
    @endcode

    @par Example: Extracting a ZIP archive
    @code{.py}
ZipFile zip("archive.zip", "r");
zip.extractAll("/destination/path", {"overwrite": True});
zip.close();
    @endcode

    @par ZIP64 Support
    ZIP64 extensions are handled automatically. Archives with more than 65,535 entries, files
    larger than 4 GB, or total archive sizes exceeding 4 GB are supported transparently without
    any special configuration.

    @since %zip 1.0
*/
qclass ZipFile [arg=QoreZipFile* zf; ns=Qore::Zip];

//! Creates a ZipFile object for reading, writing, or appending to an archive
/** @param path the path to the ZIP archive file
    @param mode the open mode: \c "r" for read, \c "w" for write (create/overwrite), \c "a" for append
    @param recover if True, enable recovery mode to read archives with corrupted central directories

    @throw ZIP-ERROR error opening the archive
*/
ZipFile::constructor(string path, string mode = "r", *bool recover) [dom=FILESYSTEM] {
    ZipMode zm = ZIP_MODE_READ;
    if (mode->empty() || mode->c_str()[0] == 'r') {
        zm = ZIP_MODE_READ;
    } else if (mode->c_str()[0] == 'w') {
        zm = ZIP_MODE_WRITE;
    } else if (mode->c_str()[0] == 'a') {
        zm = ZIP_MODE_APPEND;
    } else {
        xsink->raiseException("ZIP-ERROR", "invalid mode '%s'; must be 'r', 'w', or 'a'", mode->c_str());
        return;
    }

    ReferenceHolder<QoreZipFile> holder(new QoreZipFile(path->c_str(), zm, xsink, (bool)recover), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ZIPFILE, holder.release());
}

//! Creates a ZipFile object from binary data (in-memory archive)
/** @param data binary data containing a ZIP archive
    @param recover if True, enable recovery mode to read archives with corrupted central directories

    @throw ZIP-ERROR error parsing the archive data
*/
ZipFile::constructor(binary data, *bool recover) {
    ReferenceHolder<QoreZipFile> holder(new QoreZipFile(data, xsink, (bool)recover), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ZIPFILE, holder.release());
}

//! Creates a new empty in-memory ZIP archive
/** Use toData() to get the archive as binary data after adding entries.
*/
ZipFile::constructor() {
    ReferenceHolder<QoreZipFile> holder(new QoreZipFile(xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ZIPFILE, holder.release());
}

//! Destroys the object and closes the archive if still open
/**
*/
ZipFile::destructor() {
    zf->close(xsink);
    zf->deref(xsink);
}

//! Closes the archive
/** @throw ZIP-ERROR error closing the archive
*/
nothing ZipFile::close() {
    zf->close(xsink);
}

//! Returns the archive as binary data (for in-memory archives)
/** @return the archive as binary data

    @throw ZIP-ERROR error getting archive data or archive not in memory mode
*/
binary ZipFile::toData() {
    return zf->toData(xsink);
}

//! Returns a list of all entries in the archive
/** @return a list of @ref Qore::Zip::ZipEntryInfo hashes describing each entry

    @throw ZIP-ERROR error reading archive entries
*/
list<hash<ZipEntryInfo>> ZipFile::entries() {
    return zf->entries(xsink);
}

//! Returns the number of entries in the archive
/** @return the number of entries

    @throw ZIP-ERROR error reading archive
*/
int ZipFile::count() {
    return zf->count(xsink);
}

//! Checks if an entry exists in the archive
/** @param name the name of the entry to check

    @return True if the entry exists, False otherwise

    @throw ZIP-ERROR error reading archive
*/
bool ZipFile::hasEntry(string name) {
    return zf->hasEntry(name->c_str(), xsink);
}

//! Reads an entry from the archive as binary data
/** @param name the name of the entry to read

    @return the entry content as binary data

    @throw ZIP-ERROR error reading entry or entry not found
*/
binary ZipFile::read(string name) {
    return zf->read(name->c_str(), xsink);
}

//! Reads an entry from the archive as text
/** @param name the name of the entry to read
    @param encoding the character encoding to use (default: UTF-8)

    @return the entry content as a string

    @throw ZIP-ERROR error reading entry or entry not found
*/
string ZipFile::readText(string name, *string encoding) {
    return zf->readText(name->c_str(), encoding ? encoding->c_str() : nullptr, xsink);
}

//! Gets information about a specific entry
/** @param name the name of the entry

    @return a @ref Qore::Zip::ZipEntryInfo hash describing the entry

    @throw ZIP-ERROR error reading entry or entry not found
*/
hash<ZipEntryInfo> ZipFile::getEntry(string name) {
    return zf->getEntry(name->c_str(), xsink);
}

//! Adds binary data as an entry to the archive
/** @param name the name for the entry in the archive
    @param data the binary data to add
    @param opts optional @ref Qore::Zip::ZipAddOptions for compression and encryption settings

    @throw ZIP-ERROR error adding entry or archive not open for writing
*/
nothing ZipFile::add(string name, binary data, *hash<ZipAddOptions> opts) {
    zf->add(name->c_str(), data, opts, xsink);
}

//! Adds text as an entry to the archive
/** @param name the name for the entry in the archive
    @param text the text content to add
    @param encoding the character encoding to use (default: UTF-8)
    @param opts optional @ref Qore::Zip::ZipAddOptions for compression and encryption settings

    @throw ZIP-ERROR error adding entry or archive not open for writing
*/
nothing ZipFile::addText(string name, string text, *string encoding, *hash<ZipAddOptions> opts) {
    zf->addText(name->c_str(), text, encoding ? encoding->c_str() : nullptr, opts, xsink);
}

//! Adds a file from the filesystem to the archive
/** @param name the name for the entry in the archive
    @param filepath the path to the file on the filesystem
    @param opts optional @ref Qore::Zip::ZipAddOptions for compression and encryption settings

    @throw ZIP-ERROR error adding file or archive not open for writing
*/
nothing ZipFile::addFile(string name, string filepath, *hash<ZipAddOptions> opts) [dom=FILESYSTEM] {
    zf->addFile(name->c_str(), filepath->c_str(), opts, xsink);
}

//! Adds a directory entry to the archive
/** @param name the name for the directory entry (should end with /)

    @throw ZIP-ERROR error adding directory or archive not open for writing
*/
nothing ZipFile::addDirectory(string name) {
    zf->addDirectory(name->c_str(), xsink);
}

//! Verifies the integrity of all entries in the archive
/** Reads each entry and verifies its CRC32 checksum without extracting to disk.

    @param opts optional @ref Qore::Zip::ZipExtractOptions for password

    @return a list of @ref Qore::Zip::ZipVerifyResult hashes with per-entry verification results

    @throw ZIP-ERROR error reading archive

    @par Example:
    @code{.py}
ZipFile zip("archive.zip", "r");
list<hash<ZipVerifyResult>> results = zip.verify();
foreach hash<ZipVerifyResult> r in (results) {
    if (!r.valid) {
        printf("FAILED: %s - %s\n", r.name, r.error);
    }
}
    @endcode

    @since %zip 1.1
*/
list<hash<ZipVerifyResult>> ZipFile::verify(*hash<ZipExtractOptions> opts) {
    return zf->verify(opts, xsink);
}

//! Extracts all entries to a destination directory
/** @param destPath the destination directory path
    @param opts optional @ref Qore::Zip::ZipExtractOptions for extraction settings

    @throw ZIP-ERROR error extracting archive
*/
nothing ZipFile::extractAll(string destPath, *hash<ZipExtractOptions> opts) [dom=FILESYSTEM] {
    zf->extractAll(destPath->c_str(), opts, xsink);
}

//! Extracts specific entries to a destination directory
/** @param destPath the destination directory path
    @param entryNames list of entry names to extract
    @param opts optional @ref Qore::Zip::ZipExtractOptions for extraction settings

    @return a list of extracted file paths (excluding directories)

    @throw ZIP-ERROR error extracting archive
    @throw ZIP-SECURITY-ERROR path traversal detected

    @par Example:
    @code{.py}
ZipFile zip("archive.zip", "r");
list<string> files = zip.extractEntries("/dest", ("readme.txt", "src/main.cpp"));
    @endcode

    @since %zip 1.1
*/
list<string> ZipFile::extractEntries(string destPath, list<string> entryNames, *hash<ZipExtractOptions> opts) [dom=FILESYSTEM] {
    return zf->extractEntries(destPath->c_str(), entryNames, opts, xsink);
}

//! Extracts a single entry to a destination path
/** @param name the name of the entry to extract
    @param destPath the destination file path

    @throw ZIP-ERROR error extracting entry or entry not found
*/
nothing ZipFile::extractEntry(string name, string destPath) [dom=FILESYSTEM] {
    zf->extractEntry(name->c_str(), destPath->c_str(), xsink);
}

//! Recursively adds a file or directory to the archive
/** @param path the filesystem path to add (file or directory)
    @param root_path the base path for computing relative entry names; if not provided, the parent
        directory of \a path is used
    @param opts optional @ref Qore::Zip::ZipAddOptions for compression and encryption settings

    @throw ZIP-ERROR error adding path or archive not open for writing

    @par Example:
    @code{.py}
ZipFile zip("archive.zip", "w");
zip.addPath("/path/to/directory", "/path/to");
zip.close();
    @endcode

    @since %zip 1.1
*/
nothing ZipFile::addPath(string path, *string root_path, *hash<ZipAddOptions> opts) [dom=FILESYSTEM] {
    zf->addPath(path->c_str(), root_path ? root_path->c_str() : nullptr, opts, xsink);
}

//! Replaces or deletes entries in an archive
/** Creates a new archive with the specified modifications. Entries not in the
    replacement or deletion lists are copied as-is (zero-copy).

    @param archive_path path to the archive to modify
    @param replacements hash mapping entry names to replacement binary data (or hashes with
        a \c "data" key containing binary data)
    @param delete_names list of entry names to remove

    @return a hash with \c success (bool), \c replaced_count, \c deleted_count, and
        \c copied_count fields

    @throw ZIP-ERROR error processing the archive

    @par Example:
    @code{.py}
# Replace one entry and delete another
ZipFile::replaceEntries("archive.zip",
    {"config.json": <bead>},
    ("temp.log",));
    @endcode

    @since %zip 1.1
*/
static hash<auto> ZipFile::replaceEntries(string archive_path, *hash<auto> replacements,
    *list<string> delete_names) [dom=FILESYSTEM] {
    return QoreZipFile::replaceEntries(archive_path->c_str(), replacements, delete_names, xsink);
}

//! Compares two ZIP archives and returns the differences
/** Compares entries by name and CRC32 checksum to detect added, deleted, modified,
    and unchanged entries without extracting any data.

    @param archive1 path to the first archive (base)
    @param archive2 path to the second archive (target)

    @return a @ref Qore::Zip::ZipDiffResult hash with lists of added, deleted, modified,
        and unchanged entries

    @throw ZIP-ERROR error reading either archive

    @par Example:
    @code{.py}
hash<ZipDiffResult> diff = ZipFile::diff("old.zip", "new.zip");
printf("Added: %d, Deleted: %d, Modified: %d, Unchanged: %d\n",
    diff.added_count, diff.deleted_count, diff.modified_count, diff.unchanged_count);
    @endcode

    @since %zip 1.1
*/
static hash<ZipDiffResult> ZipFile::diff(string archive1, string archive2) [dom=FILESYSTEM] {
    return QoreZipFile::diff(archive1->c_str(), archive2->c_str(), xsink);
}

//! Re-compresses an archive with a different compression method
/** Reads all entries from the archive and rewrites them using the specified compression
    method and level. Directory entries and metadata are preserved.

    @param archive_path path to the archive to recompress
    @param compression_method the new compression method (one of @ref zip_compression_methods)
    @param compression_level optional compression level (0-9)
    @param password optional password for encrypted archives

    @return a hash with \c success (bool), \c entry_count, \c original_size, and
        \c new_size fields

    @throw ZIP-ERROR error processing the archive

    @par Example:
    @code{.py}
# Convert from deflate to zstd
ZipFile::recompress("archive.zip", ZIP_CM_ZSTD, 3);
    @endcode

    @since %zip 1.1
*/
static hash<auto> ZipFile::recompress(string archive_path, int compression_method,
    *int compression_level, *string password) [dom=FILESYSTEM] {
    return QoreZipFile::recompress(archive_path->c_str(), (int16_t)compression_method,
        compression_level ? (int16_t)compression_level : MZ_COMPRESS_LEVEL_DEFAULT,
        password ? password->c_str() : nullptr, xsink);
}

//! Adds a symbolic link entry to the archive
/** @param name the name for the symlink entry in the archive
    @param target the symlink target path

    @throw ZIP-ERROR error adding entry or archive not open for writing

    @note This is primarily intended for testing symlink security validation.

    @since %zip 1.1
*/
nothing ZipFile::addSymlink(string name, string target) {
    zf->addSymlink(name->c_str(), target->c_str(), xsink);
}

//! Deletes an entry from the archive
/** @param name the name of the entry to delete

    @throw ZIP-ERROR error deleting entry or archive not open for writing

    @note This operation may require rewriting the archive
*/
nothing ZipFile::delete(string name) [dom=FILESYSTEM] {
    zf->deleteEntry(name->c_str(), xsink);
}

//! Sets the password for reading encrypted entries
/** @param password the password to use for subsequent read operations (read(), readText(),
        openRead(), extractEntry()), or \c NOTHING to clear

    @par Example:
    @code{.py}
ZipFile zip(encrypted_data);
zip.setPassword("secret");
string content = zip.readText("file.txt");
    @endcode

    @since %zip 1.1
*/
nothing ZipFile::setPassword(*string password) {
    zf->setPassword(password ? password->c_str() : nullptr);
}

//! Returns the path of the archive file
/** @return the file path, or an empty string for in-memory archives
*/
*string ZipFile::path() {
    return zf->getPath();
}

//! Returns the archive comment
/** @return the archive comment, or NOTHING if not set

    @throw ZIP-ERROR error reading archive comment
*/
*string ZipFile::comment() {
    return zf->getComment(xsink);
}

//! Sets the archive comment
/** @param comment the comment to set

    @throw ZIP-ERROR error setting comment or archive not open for writing
*/
nothing ZipFile::setComment(string comment) {
    zf->setComment(comment->c_str(), xsink);
}

//! Opens an input stream for reading an entry from the archive
/** @param name the name of the entry to read

    @return a @ref ZipInputStream object for reading the entry data

    @throw ZIP-ERROR if the archive is not open for reading or the entry is not found

    @par Example:
    @code{.py}
ZipFile zip("archive.zip", "r");
ZipInputStream is = zip.openRead("large_file.bin");
while (*binary data = is.read(65536)) {
    # process chunk
}
    @endcode

    @see ZipInputStream
*/
ZipInputStream ZipFile::openRead(string name) {
    return zf->openInputStream(name->c_str(), xsink);
}

//! Opens an output stream for writing a new entry to the archive
/** @param name the name for the new entry
    @param opts optional @ref Qore::Zip::ZipAddOptions for compression and encryption settings

    @return a @ref ZipOutputStream object for writing the entry data

    @throw ZIP-ERROR if the archive is not open for writing

    @par Example:
    @code{.py}
ZipFile zip("archive.zip", "w");
ZipOutputStream os = zip.openWrite("large_file.bin", {"compression_level": 9});
os.write(chunk1);
os.write(chunk2);
os.close();
zip.close();
    @endcode

    @note You must call close() on the stream when done writing to finalize the entry.

    @see ZipOutputStream
*/
ZipOutputStream ZipFile::openWrite(string name, *hash<ZipAddOptions> opts) {
    return zf->openOutputStream(name->c_str(), opts, xsink);
}
