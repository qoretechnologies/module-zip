set -eu
qzip_binary=${1:-/usr/bin/qzip}
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
cd "$work_dir"
"$qzip_binary" --help > help.txt
if "$qzip_binary" > missing.txt 2>&1; then
    echo 'qzip without a command unexpectedly succeeded' >&2
    exit 1
fi
printf '%s\n' 'ZIP package interoperability' > 'input file.txt'
"$qzip_binary" create plain.zip 'input file.txt'
unzip -t plain.zip
unzip -p plain.zip 'input file.txt' > decoded.txt
cmp 'input file.txt' decoded.txt
"$qzip_binary" list plain.zip > list.txt
grep -q 'input file.txt' list.txt
"$qzip_binary" verify plain.zip
"$qzip_binary" extract --dest extracted plain.zip
cmp 'input file.txt' 'extracted/input file.txt'
"$qzip_binary" create --password package-test --encryption pkware encrypted.zip 'input file.txt'
unzip -P package-test -p encrypted.zip 'input file.txt' > decrypted.txt
cmp 'input file.txt' decrypted.txt
