%modern

%requires QUnit
%requires Util
%requires DataProvider
%requires zip
%requires ZipDataProvider

%exec-class ZipDataProviderTest

public class ZipDataProviderTest inherits QUnit::Test {
    private {
        string testDir;
    }

    constructor() : Test("ZipDataProviderTest", "1.0") {
        testDir = tmp_location() + "/zip_dp_test_" + string(getpid());

        addTestCase("Enum tests", \enumTest());
        addTestCase("Type metadata tests", \typeMetadataTest());
        addTestCase("Field descriptions tests", \fieldDescriptionsTest());
        addTestCase("Required groups validation tests", \requiredGroupsValidationTest());
        addTestCase("Backward compatibility tests", \backwardCompatibilityTest());
        addTestCase("Module loading tests", \moduleLoadingTest());
        addTestCase("App registration tests", \appRegistrationTest());
        addTestCase("Integration tests", \integrationTest());
        addTestCase("Compression tests", \compressionTest());
        addTestCase("Create archive action tests", \createArchiveActionTest());
        addTestCase("Extract archive action tests", \extractArchiveActionTest());
        addTestCase("List archive action tests", \listArchiveActionTest());
        addTestCase("Archive info action tests", \archiveInfoActionTest());
        addTestCase("Add files action tests", \addFilesActionTest());
        addTestCase("Extract file action tests", \extractFileActionTest());
        addTestCase("Compress data action tests", \compressDataActionTest());
        addTestCase("Decompress data action tests", \decompressDataActionTest());
        addTestCase("Location input tests", \locationInputTest());
        addTestCase("Filter extract tests", \filterExtractTest());
        addTestCase("Filter list tests", \filterListTest());
        addTestCase("Filter decompress tests", \filterDecompressTest());
        addTestCase("Filter info tests", \filterInfoTest());
        addTestCase("Extract options tests", \extractOptionsTest());
        addTestCase("Add path action tests", \addPathActionTest());
        addTestCase("Verify action tests", \verifyActionTest());
        addTestCase("Replace action tests", \replaceActionTest());

        set_return_value(main());
    }

    setUp() {
        mkdir(testDir, 0755);
    }

    tearDown() {
        if (is_dir(testDir)) {
            system("rm -rf " + testDir);
        }
    }

    # ==================== Enum Tests ====================

    enumTest() {
        # Test CompressionMethod enum values
        assertEq(0, CompressionMethod::Store, "CompressionMethod::Store");
        assertEq(8, CompressionMethod::Deflate, "CompressionMethod::Deflate");
        assertEq(12, CompressionMethod::BZip2, "CompressionMethod::BZip2");
        assertEq(14, CompressionMethod::Lzma, "CompressionMethod::Lzma");
        assertEq(93, CompressionMethod::Zstd, "CompressionMethod::Zstd");
        assertEq(95, CompressionMethod::Xz, "CompressionMethod::Xz");

        # Test CompressionLevel enum values
        assertEq(-1, CompressionLevel::Default, "CompressionLevel::Default");
        assertEq(0, CompressionLevel::Store, "CompressionLevel::Store");
        assertEq(1, CompressionLevel::Fastest, "CompressionLevel::Fastest");
        assertEq(9, CompressionLevel::Best, "CompressionLevel::Best");

        # Test EncryptionMethod enum values
        assertEq(0, EncryptionMethod::None, "EncryptionMethod::None");
        assertEq(1, EncryptionMethod::TradPkware, "EncryptionMethod::TradPkware");
        assertEq(0x0101, EncryptionMethod::Aes128, "EncryptionMethod::Aes128");
        assertEq(0x0102, EncryptionMethod::Aes192, "EncryptionMethod::Aes192");
        assertEq(0x0103, EncryptionMethod::Aes256, "EncryptionMethod::Aes256");

        # Test that enums match C++ constants
        assertEq(ZIP_CM_STORE, CompressionMethod::Store, "enum matches ZIP_CM_STORE");
        assertEq(ZIP_CM_DEFLATE, CompressionMethod::Deflate, "enum matches ZIP_CM_DEFLATE");
        assertEq(ZIP_EM_NONE, EncryptionMethod::None, "enum matches ZIP_EM_NONE");
        assertEq(ZIP_EM_AES_256, EncryptionMethod::Aes256, "enum matches ZIP_EM_AES_256");
    }

    # ==================== Type Metadata Tests ====================

    typeMetadataTest() {
        # Test that request types have allowed_values for compression_method
        ZipCreateArchiveRequestDataType requestType();
        *AbstractDataField cmField = requestType.getField("compression_method");
        assertEq(True, exists cmField, "compression_method field exists");

        *list<auto> allowedValues = cmField.getAllowedValues();
        assertEq(True, allowedValues.val(), "compression_method has allowed values");
        assertEq(6, allowedValues.size(), "compression_method has 6 allowed values");

        # Verify one of the allowed values
        bool foundDeflate = False;
        foreach auto av in (allowedValues) {
            if (av.value == CompressionMethod::Deflate) {
                assertEq("Deflate", av.display_name, "Deflate display_name");
                foundDeflate = True;
                break;
            }
        }
        assertEq(True, foundDeflate, "Deflate is in allowed values");

        # Test ZipCompressDataRequestDataType also has compression_method with allowed_values
        ZipCompressDataRequestDataType compressType();
        *AbstractDataField cmField2 = compressType.getField("compression_method");
        assertEq(True, exists cmField2, "compress data has compression_method");
        assertEq(True, cmField2.getAllowedValues().val(), "compress data has allowed values");
    }

    # ==================== Field Descriptions Tests ====================

    fieldDescriptionsTest() {
        # Test that fields have display_name and desc
        ZipCreateArchiveRequestDataType requestType();

        # Check compression_method field metadata
        *AbstractDataField cmField = requestType.getField("compression_method");
        hash<DataFieldInfo> cmInfo = cmField.getInfo();
        assertEq("Compression Method", cmInfo.display_name, "compression_method display_name");
        assertEq(True, cmInfo.desc.val(), "compression_method has description");
        assertEq(True, cmInfo.short_desc.val(), "compression_method has short_desc");

        # Check output_path field metadata
        *AbstractDataField opField = requestType.getField("output_path");
        hash<DataFieldInfo> opInfo = opField.getInfo();
        assertEq("Output Path", opInfo.display_name, "output_path display_name");
        assertEq(True, opInfo.desc.val(), "output_path has description");

        # Check entries field metadata
        *AbstractDataField entriesField = requestType.getField("entries");
        hash<DataFieldInfo> entriesInfo = entriesField.getInfo();
        assertEq("Entries", entriesInfo.display_name, "entries display_name");

        # Test response type fields
        ZipCreateArchiveResponseDataType responseType();
        *AbstractDataField successField = responseType.getField("success");
        hash<DataFieldInfo> successInfo = successField.getInfo();
        assertEq("Success", successInfo.display_name, "success display_name");
    }

    # ==================== Required Groups Validation Tests ====================

    requiredGroupsValidationTest() {
        # Test that required groups are properly defined and enforced
        ZipDataProvider factory();

        # Test ZipExtractArchiveRequestDataType required groups
        {
            ZipExtractArchiveRequestDataType extractType();
            assertTrue(extractType.hasRequiredGroups(), "extract archive type has required groups");
            list<list<string>> groups = extractType.getRequiredGroups();
            assertEq(1, groups.size(), "extract archive has one required group");
            assertTrue(inlist("input_path", groups[0]), "group contains input_path");
            assertTrue(inlist("data", groups[0]), "group contains data");
            assertTrue(inlist("location", groups[0]), "group contains location");

            # Test validation via data provider
            AbstractDataProvider extractDp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
                extractDp.doRequest({"destination": "/tmp/test"});
            }, NOTHING, "extract without input source throws REQUIRED-FIELD-GROUP-ERROR");
        }

        # Test ZipListArchiveRequestDataType required groups
        {
            ZipListArchiveRequestDataType listType();
            assertTrue(listType.hasRequiredGroups(), "list archive type has required groups");

            AbstractDataProvider listDp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
                listDp.doRequest({});
            }, NOTHING, "list without input source throws REQUIRED-FIELD-GROUP-ERROR");
        }

        # Test ZipArchiveInfoRequestDataType required groups
        {
            ZipArchiveInfoRequestDataType infoType();
            assertTrue(infoType.hasRequiredGroups(), "archive info type has required groups");

            AbstractDataProvider infoDp = factory.getChildProviderEx("archive").getChildProviderEx("info");
            assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
                infoDp.doRequest({});
            }, NOTHING, "info without input source throws REQUIRED-FIELD-GROUP-ERROR");
        }

        # Test ZipExtractFileRequestDataType required groups
        {
            ZipExtractFileRequestDataType extractFileType();
            assertTrue(extractFileType.hasRequiredGroups(), "extract file type has required groups");
            list<list<string>> groups = extractFileType.getRequiredGroups();
            assertEq(1, groups.size(), "extract file has one required group");
            assertTrue(inlist("archive_path", groups[0]), "group contains archive_path");
            assertTrue(inlist("archive_data", groups[0]), "group contains archive_data");
            assertTrue(inlist("archive_location", groups[0]), "group contains archive_location");

            AbstractDataProvider extractFileDp = factory.getChildProviderEx("file").getChildProviderEx("extract");
            assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
                extractFileDp.doRequest({"entry_name": "test.txt"});
            }, NOTHING, "extract file without archive source throws REQUIRED-FIELD-GROUP-ERROR");
        }

        # Test that required_groups appears in type info metadata
        {
            ZipExtractArchiveRequestDataType extractType();
            hash<DataTypeInfo> info = extractType.getInfo();
            assertTrue(exists info.required_groups, "type info includes required_groups");
            assertEq(1, info.required_groups.size(), "info has one required group");
        }

        # Verify error message is user-friendly
        {
            AbstractDataProvider listDp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            try {
                listDp.doRequest({});
                fail("Should have thrown REQUIRED-FIELD-GROUP-ERROR");
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(ex.desc.find("input_path") >= 0 || ex.desc.find("data") >= 0,
                    "error message mentions the required fields");
                assertTrue(ex.desc.find("at least one") >= 0,
                    "error message explains the constraint");
            }
        }
    }

    # ==================== Backward Compatibility Tests ====================

    backwardCompatibilityTest() {
        # Test that existing hashdecls still work
        list<hash<auto>> createEntries = ({"name": "test.txt", "data": binary("test")},);
        hash<ZipCreateArchiveRequest> createReq = <ZipCreateArchiveRequest>{
            "entries": createEntries,
            "compression_method": ZIP_CM_DEFLATE,
        };
        assertEq(True, exists createReq.entries, "hashdecl entries field works");
        assertEq(ZIP_CM_DEFLATE, createReq.compression_method, "hashdecl compression_method works");

        hash<ZipExtractArchiveRequest> extractReq = <ZipExtractArchiveRequest>{
            "input_path": "/path/to/archive.zip",
            "destination": "/path/to/dest",
        };
        assertEq("/path/to/archive.zip", extractReq.input_path, "hashdecl input_path works");

        hash<ZipListArchiveRequest> listReq = <ZipListArchiveRequest>{
            "input_path": "/path/to/archive.zip",
        };
        assertEq(True, exists listReq.input_path, "hashdecl list request works");

        list<hash<auto>> compressEntries = ({"name": "test.txt", "data": binary("test")},);
        hash<ZipCompressDataRequest> compressReq = <ZipCompressDataRequest>{
            "entries": compressEntries,
        };
        assertEq(True, exists compressReq.entries, "hashdecl compress request works");

        hash<ZipDecompressDataRequest> decompressReq = <ZipDecompressDataRequest>{
            "data": binary("test"),
        };
        assertEq(True, decompressReq.data.val(), "hashdecl decompress request works");

        # Test response hashdecls
        hash<ZipCreateArchiveResponse> createResp = <ZipCreateArchiveResponse>{
            "success": True,
            "entry_count": 1,
            "size": 100,
        };
        assertEq(True, createResp.success, "hashdecl response works");
    }

    # ==================== Module Loading Tests ====================

    moduleLoadingTest() {
        # Test that ZipDataProvider module loads successfully
        assertEq(True, True, "ZipDataProvider module loaded");

        # Test that the factory is registered
        AbstractDataProviderFactory zipFactory = DataProvider::getFactory("zip");
        assertEq(True, exists zipFactory, "zip factory is registered");
        assertEq("zip", zipFactory.getName(), "factory name is 'zip'");
    }

    # ==================== App Registration Tests ====================

    appRegistrationTest() {
        # Test app registration
        *hash<DataProviderAppInfo> appInfo = DataProviderActionCatalog::getApp("Zip");
        assertEq(True, exists appInfo, "Zip app is registered");
        assertEq("Zip", appInfo.name, "app name is Zip");
        assertEq("Zip Archive", appInfo.display_name, "app display_name");
        assertEq(True, exists appInfo.short_desc, "app has short_desc");
        assertEq(True, exists appInfo.desc, "app has desc");
        assertEq(True, exists appInfo.logo, "app has logo");
        assertEq("zip-logo.svg", appInfo.logo_file_name, "app logo_file_name");
        assertEq(MimeTypeSvg, appInfo.logo_mime_type, "app logo_mime_type");

        # Verify logo is valid SVG
        assertEq(True, appInfo.logo.find("<svg") >= 0, "logo contains SVG tag");
        assertEq(True, appInfo.logo.find("</svg>") >= 0, "logo contains closing SVG tag");
    }

    # ==================== Integration Tests ====================

    integrationTest() {
        # Full workflow test: create -> list -> extract -> verify

        string zipPath = testDir + "/dp_integration.zip";
        string extractDir = testDir + "/dp_integration_extracted";
        mkdir(extractDir);

        # Step 1: Create archive using ZipFile
        {
            ZipFile zip(zipPath, "w");
            zip.addText("readme.txt", "Integration test readme");
            zip.addText("data/config.json", '{"setting": "value"}');
            zip.addText("data/users.csv", "id,name\n1,Alice\n2,Bob");
            zip.setComment("Integration test archive");
            zip.close();
        }

        # Step 2: Verify archive was created
        assertEq(True, is_file(zipPath), "archive file exists");

        # Step 3: List contents
        {
            ZipFile zip(zipPath, "r");
            list<hash<ZipEntryInfo>> entries = zip.entries();
            assertEq(3, entries.size(), "integration archive has 3 entries");

            # Verify entry names
            hash<string, bool> entryNames;
            foreach hash<ZipEntryInfo> entry in (entries) {
                entryNames{entry.name} = True;
            }
            assertEq(True, exists entryNames{"readme.txt"}, "has readme.txt");
            assertEq(True, exists entryNames{"data/config.json"}, "has data/config.json");
            assertEq(True, exists entryNames{"data/users.csv"}, "has data/users.csv");
            zip.close();
        }

        # Step 4: Extract archive
        {
            ZipFile zip(zipPath, "r");
            zip.extractAll(extractDir);
            zip.close();
        }

        # Step 5: Verify extraction
        assertEq(True, is_file(extractDir + "/readme.txt"), "readme.txt extracted");
        assertEq(True, is_file(extractDir + "/data/config.json"), "data/config.json extracted");
        assertEq(True, is_file(extractDir + "/data/users.csv"), "data/users.csv extracted");

        # Verify content
        string readmeContent = ReadOnlyFile::readTextFile(extractDir + "/readme.txt");
        assertEq("Integration test readme", readmeContent, "readme content matches");

        string jsonContent = ReadOnlyFile::readTextFile(extractDir + "/data/config.json");
        assertEq('{"setting": "value"}', jsonContent, "json content matches");

        # Step 6: Create in-memory archive and decompress
        binary memArchive;
        {
            ZipFile zip();
            zip.addText("memory1.txt", "Memory content 1");
            zip.addText("memory2.txt", "Memory content 2");
            memArchive = zip.toData();
        }

        assertEq(True, memArchive.size() > 0, "in-memory archive created");

        # Verify in-memory archive contents
        {
            ZipFile zip(memArchive);
            assertEq(2, zip.count(), "memory archive has 2 entries");
            string content1 = zip.readText("memory1.txt");
            assertEq("Memory content 1", content1, "memory1 content matches");
            zip.close();
        }
    }

    # ==================== Compression Tests ====================

    compressionTest() {
        # Test compression with data provider workflow
        string largeContent = strmul("This is test content for compression testing. ", 1000);
        binary compressedArchive;
        {
            ZipFile zip();
            zip.addText("large.txt", largeContent, NOTHING, <ZipAddOptions>{
                "compression_method": ZIP_CM_DEFLATE,
                "compression_level": ZIP_COMPRESSION_BEST,
            });
            compressedArchive = zip.toData();
        }

        # Verify compression worked (archive should be smaller than content)
        assertEq(True, compressedArchive.size() < largeContent.size(), "compression reduced size");

        # Verify content integrity
        {
            ZipFile zip(compressedArchive);
            string decompressed = zip.readText("large.txt");
            assertEq(largeContent, decompressed, "decompressed content matches original");
            zip.close();
        }
    }

    # ==================== Create Archive Action Tests ====================

    createArchiveActionTest() {
        # Get the create archive data provider using factory path
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("create");
        assertEq(True, exists dp, "create archive provider exists");
        assertEq("create", dp.getName(), "provider name is 'create'");

        # Test creating archive to file
        {
            string zipPath = testDir + "/dp_create_file.zip";
            hash<auto> request = {
                "output_path": zipPath,
                "entries": (
                    {"name": "file1.txt", "data": binary("Content 1")},
                    {"name": "file2.txt", "data": binary("Content 2")},
                ),
                "comment": "Test archive",
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "create file archive succeeded");
            assertEq(2, response.entry_count, "entry count is 2");
            assertEq(zipPath, response.output_path, "output path matches");
            assertEq(True, response.size > 0, "archive has size");
            assertEq(True, is_file(zipPath), "archive file exists");

            # Verify contents
            ZipFile zip(zipPath, "r");
            assertEq(2, zip.count(), "archive has 2 entries");
            assertEq("Content 1", zip.readText("file1.txt"), "file1 content matches");
            zip.close();
        }

        # Test creating in-memory archive
        {
            hash<auto> request = {
                "entries": (
                    {"name": "mem1.txt", "data": binary("Memory content")},
                ),
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "create memory archive succeeded");
            assertEq(1, response.entry_count, "entry count is 1");
            assertEq(True, exists response.data, "response has data");
            assertEq(True, response.data.size() > 0, "data has content");

            # Verify contents
            ZipFile zip(response.data);
            assertEq("Memory content", zip.readText("mem1.txt"), "memory content matches");
            zip.close();
        }
    }

    # ==================== Extract Archive Action Tests ====================

    extractArchiveActionTest() {
        # Create test archive first
        string zipPath = testDir + "/dp_extract_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("extract1.txt", "Extract content 1");
            zip.addText("subdir/extract2.txt", "Extract content 2");
            zip.close();
        }

        # Get the extract archive data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
        assertEq(True, exists dp, "extract archive provider exists");

        # Test extracting from file
        {
            string extractDir = testDir + "/dp_extracted";
            mkdir(extractDir);

            hash<auto> request = {
                "input_path": zipPath,
                "destination": extractDir,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "extract succeeded");
            assertEq(2, response.entry_count, "entry count is 2");
            assertEq(extractDir, response.destination, "destination matches");
            assertEq(True, response.extracted_files.size() > 0, "has extracted files list");

            # Verify extraction
            assertEq(True, is_file(extractDir + "/extract1.txt"), "extract1.txt exists");
            assertEq(True, is_file(extractDir + "/subdir/extract2.txt"), "subdir/extract2.txt exists");
            assertEq("Extract content 1", ReadOnlyFile::readTextFile(extractDir + "/extract1.txt"), "content matches");
        }

        # Test extracting from binary data
        {
            binary archiveData = File::readBinaryFile(zipPath);
            string extractDir2 = testDir + "/dp_extracted2";
            mkdir(extractDir2);

            hash<auto> request = {
                "data": archiveData,
                "destination": extractDir2,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "extract from binary succeeded");
            assertEq(True, is_file(extractDir2 + "/extract1.txt"), "file extracted from binary");
        }
    }

    # ==================== List Archive Action Tests ====================

    listArchiveActionTest() {
        # Create test archive
        string zipPath = testDir + "/dp_list_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("list1.txt", "List content 1");
            zip.addText("list2.txt", "List content 2");
            zip.addDirectory("emptydir/");
            zip.close();
        }

        # Get the list archive data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("list");
        assertEq(True, exists dp, "list archive provider exists");

        # Test listing from file
        {
            hash<auto> request = {
                "input_path": zipPath,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(3, response.count, "count is 3");
            assertEq(3, response.entries.size(), "entries list has 3 items");

            # Check entry details
            hash<string, hash<ZipEntryInfo>> entriesByName;
            foreach hash<ZipEntryInfo> entry in (response.entries) {
                entriesByName{entry.name} = entry;
            }
            assertEq(True, exists entriesByName{"list1.txt"}, "has list1.txt");
            assertEq(True, exists entriesByName{"list2.txt"}, "has list2.txt");
            assertEq(True, exists entriesByName{"emptydir/"}, "has emptydir/");
            assertEq(True, entriesByName{"emptydir/"}.is_directory, "emptydir is directory");
        }

        # Test listing from binary data
        {
            binary archiveData = File::readBinaryFile(zipPath);
            hash<auto> request = {
                "data": archiveData,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(3, response.count, "count from binary is 3");
        }
    }

    # ==================== Archive Info Action Tests ====================

    archiveInfoActionTest() {
        # Create test archive with comment
        string zipPath = testDir + "/dp_info_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("info1.txt", "Info content 1");
            zip.addText("info2.txt", strmul("Large content ", 100));
            zip.setComment("Test archive comment");
            zip.close();
        }

        # Get the archive info data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("info");
        assertEq(True, exists dp, "archive info provider exists");

        # Test getting info
        {
            hash<auto> request = {
                "input_path": zipPath,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(zipPath, response.path, "path matches");
            assertEq(2, response.entry_count, "entry count is 2");
            assertEq(True, response.total_size > 0, "has total size");
            assertEq(True, response.compressed_size > 0, "has compressed size");
            assertEq("Test archive comment", response.comment, "comment matches");
        }
    }

    # ==================== Add Files Action Tests ====================

    addFilesActionTest() {
        # Create initial archive
        string zipPath = testDir + "/dp_add_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("original.txt", "Original content");
            zip.close();
        }

        # Get the add files data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("add");
        assertEq(True, exists dp, "add files provider exists");

        # Test adding files
        {
            hash<auto> request = {
                "archive_path": zipPath,
                "entries": (
                    {"name": "added1.txt", "data": binary("Added content 1")},
                    {"name": "added2.txt", "data": binary("Added content 2")},
                ),
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "add files succeeded");
            assertEq(2, response.entries_added, "2 entries added");

            # Verify archive now has all files
            ZipFile zip(zipPath, "r");
            assertEq(3, zip.count(), "archive now has 3 entries");
            assertEq(True, zip.hasEntry("original.txt"), "original still exists");
            assertEq(True, zip.hasEntry("added1.txt"), "added1 exists");
            assertEq(True, zip.hasEntry("added2.txt"), "added2 exists");
            zip.close();
        }
    }

    # ==================== Extract File Action Tests ====================

    extractFileActionTest() {
        # Create test archive
        string zipPath = testDir + "/dp_extract_file_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("single.txt", "Single file content");
            zip.addText("other.txt", "Other content");
            zip.close();
        }

        # Get the extract file data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("file").getChildProviderEx("extract");
        assertEq(True, exists dp, "extract file provider exists");

        # Test extracting to memory
        {
            hash<auto> request = {
                "archive_path": zipPath,
                "entry_name": "single.txt",
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "extract to memory succeeded");
            assertEq("single.txt", response.entry_name, "entry name matches");
            assertEq(True, exists response.data, "response has data");
            assertEq("Single file content", response.data.toString("UTF-8"), "content matches");
            assertEq(True, response.size > 0, "has size");
        }

        # Test extracting to file
        {
            string outputPath = testDir + "/dp_single_extracted.txt";
            hash<auto> request = {
                "archive_path": zipPath,
                "entry_name": "single.txt",
                "output_path": outputPath,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "extract to file succeeded");
            assertEq(outputPath, response.output_path, "output path matches");
            assertEq(True, is_file(outputPath), "output file exists");
            assertEq("Single file content", ReadOnlyFile::readTextFile(outputPath), "file content matches");
        }

        # Test extracting from binary archive
        {
            binary archiveData = File::readBinaryFile(zipPath);
            hash<auto> request = {
                "archive_data": archiveData,
                "entry_name": "other.txt",
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, response.success, "extract from binary succeeded");
            assertEq("Other content", response.data.toString("UTF-8"), "content from binary matches");
        }
    }

    # ==================== Compress Data Action Tests ====================

    compressDataActionTest() {
        # Get the compress data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("compress");
        assertEq(True, exists dp, "compress data provider exists");

        # Test compressing data
        {
            hash<auto> request = {
                "entries": (
                    {"name": "compress1.txt", "data": binary("Compress content 1")},
                    {"name": "compress2.txt", "data": binary("Compress content 2")},
                ),
                "compression_method": ZIP_CM_DEFLATE,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, exists response.data, "response has data");
            assertEq(2, response.entry_count, "entry count is 2");
            assertEq(True, response.size > 0, "has size");

            # Verify the compressed data is valid
            ZipFile zip(response.data);
            assertEq(2, zip.count(), "compressed archive has 2 entries");
            assertEq("Compress content 1", zip.readText("compress1.txt"), "content 1 matches");
            assertEq("Compress content 2", zip.readText("compress2.txt"), "content 2 matches");
            zip.close();
        }

        # Test with password
        {
            hash<auto> request = {
                "entries": (
                    {"name": "secret.txt", "data": binary("Secret content")},
                ),
                "password": "TestPassword123",
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(True, exists response.data, "encrypted response has data");

            # Verify it's encrypted
            ZipFile zip(response.data);
            hash<ZipEntryInfo> entry = zip.getEntry("secret.txt");
            assertEq(True, entry.is_encrypted, "entry is encrypted");
            zip.close();
        }
    }

    # ==================== Decompress Data Action Tests ====================

    decompressDataActionTest() {
        # Create test archive data
        binary archiveData;
        {
            ZipFile zip();
            zip.addText("decomp1.txt", "Decompress content 1");
            zip.addText("decomp2.txt", "Decompress content 2");
            zip.addText("decomp3.txt", "Decompress content 3");
            archiveData = zip.toData();
        }

        # Get the decompress data provider
        ZipDataProvider factory();
        AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
        assertEq(True, exists dp, "decompress data provider exists");

        # Test decompressing all entries
        {
            hash<auto> request = {
                "data": archiveData,
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(3, response.entry_count, "entry count is 3");
            assertEq(3, response.entries.size(), "entries hash has 3 items");
            assertEq("Decompress content 1", response.entries{"decomp1.txt"}.toString("UTF-8"), "content 1 matches");
            assertEq("Decompress content 2", response.entries{"decomp2.txt"}.toString("UTF-8"), "content 2 matches");
            assertEq("Decompress content 3", response.entries{"decomp3.txt"}.toString("UTF-8"), "content 3 matches");
        }

        # Test decompressing specific entries
        {
            hash<auto> request = {
                "data": archiveData,
                "entry_names": ("decomp1.txt", "decomp3.txt"),
            };

            hash<auto> response = dp.doRequest(request);
            assertEq(2, response.entry_count, "filtered entry count is 2");
            assertEq(True, exists response.entries{"decomp1.txt"}, "has decomp1.txt");
            assertEq(True, exists response.entries{"decomp3.txt"}, "has decomp3.txt");
            assertEq(False, exists response.entries{"decomp2.txt"}, "does not have decomp2.txt");
        }
    }

    # ==================== Location Input Tests ====================

    locationInputTest() {
        # Create a test archive on disk
        string zipPath = testDir + "/location_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("loc1.txt", "Location content 1");
            zip.addText("loc2.txt", "Location content 2");
            zip.close();
        }

        string fileUrl = "file://" + zipPath;
        ZipDataProvider factory();

        # Test list archive with location input
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            hash<auto> response = dp.doRequest({"location": fileUrl});
            assertEq(2, response.count, "list via location: count is 2");
            assertEq(2, response.entries.size(), "list via location: entries has 2 items");
        }

        # Test archive info with location input
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("info");
            hash<auto> response = dp.doRequest({"location": fileUrl});
            assertEq(2, response.entry_count, "info via location: entry count is 2");
            assertEq(True, response.total_size > 0, "info via location: has total size");
        }

        # Test extract archive with location input
        {
            string extractDir = testDir + "/location_extracted";
            mkdir(extractDir);
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "location": fileUrl,
                "destination": extractDir,
            });
            assertEq(True, response.success, "extract via location succeeded");
            assertEq(2, response.entry_count, "extract via location: 2 entries");
            assertEq(True, is_file(extractDir + "/loc1.txt"), "extract via location: loc1.txt exists");
            assertEq("Location content 1",
                ReadOnlyFile::readTextFile(extractDir + "/loc1.txt"),
                "extract via location: content matches");
        }

        # Test extract file with archive_location input
        {
            AbstractDataProvider dp = factory.getChildProviderEx("file").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "archive_location": fileUrl,
                "entry_name": "loc1.txt",
            });
            assertEq(True, response.success, "extract file via location succeeded");
            assertEq("Location content 1", response.data.toString("UTF-8"),
                "extract file via location: content matches");
        }

        # Test extract file with output_location
        {
            string outputPath = testDir + "/location_output.txt";
            string outputUrl = "file://" + outputPath;
            AbstractDataProvider dp = factory.getChildProviderEx("file").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "archive_location": fileUrl,
                "entry_name": "loc2.txt",
                "output_location": outputUrl,
            });
            assertEq(True, response.success, "extract file with output_location succeeded");
            assertEq(True, is_file(outputPath), "output_location file exists");
            assertEq("Location content 2", ReadOnlyFile::readTextFile(outputPath),
                "output_location content matches");
        }

        # Test create archive with output_location
        {
            string outputPath = testDir + "/location_created.zip";
            string outputUrl = "file://" + outputPath;
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("create");
            hash<auto> response = dp.doRequest({
                "output_location": outputUrl,
                "entries": (
                    {"name": "new1.txt", "data": binary("New content 1")},
                ),
            });
            assertEq(True, response.success, "create with output_location succeeded");
            assertEq(True, response.size > 0, "create with output_location: has size");
            assertEq(True, is_file(outputPath), "output_location archive exists");

            # Verify archive contents
            ZipFile zip(outputPath, "r");
            assertEq(1, zip.count(), "output_location archive has 1 entry");
            assertEq("New content 1", zip.readText("new1.txt"), "output_location archive content matches");
            zip.close();
        }

        # Test decompress data with archive_path
        {
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
            hash<auto> response = dp.doRequest({
                "archive_path": zipPath,
            });
            assertEq(2, response.entry_count, "decompress via archive_path: entry count is 2");
            assertEq("Location content 1", response.entries{"loc1.txt"}.toString("UTF-8"),
                "decompress via archive_path: content matches");
        }

        # Test decompress data with archive_location
        {
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
            hash<auto> response = dp.doRequest({
                "archive_location": fileUrl,
            });
            assertEq(2, response.entry_count, "decompress via archive_location: entry count is 2");
            assertEq("Location content 2", response.entries{"loc2.txt"}.toString("UTF-8"),
                "decompress via archive_location: content matches");
        }

        # Test decompress required groups validation
        {
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
            assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
                dp.doRequest({"entry_names": ("test.txt",)});
            }, NOTHING, "decompress without input source throws REQUIRED-FIELD-GROUP-ERROR");
        }

        # Test compress data with output_location
        {
            string outputPath = testDir + "/location_compressed.zip";
            string outputUrl = "file://" + outputPath;
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("compress");
            hash<auto> response = dp.doRequest({
                "entries": (
                    {"name": "compressed.txt", "data": binary("Compressed data")},
                ),
                "output_location": outputUrl,
            });
            assertEq(True, response.size > 0, "compress with output_location: has size");
            assertEq(True, is_file(outputPath), "compress output_location file exists");

            # Verify archive contents
            ZipFile zip(outputPath, "r");
            assertEq("Compressed data", zip.readText("compressed.txt"),
                "compress output_location content matches");
            zip.close();
        }
    }

    #! Helper to create a test archive with mixed file types
    private binary createFilterTestArchive() {
        ZipFile zip();
        zip.addText("readme.txt", "README");
        zip.addText("data/report.csv", "a,b,c");
        zip.addText("data/report.log", "log data");
        zip.addText("src/main.cpp", "int main() {}");
        zip.addText("src/util.cpp", "void util() {}");
        zip.addText("temp_notes.txt", "temp notes");
        zip.addDirectory("empty/");
        return zip.toData();
    }

    filterExtractTest() {
        ZipDataProvider factory();
        binary archive_data = createFilterTestArchive();

        # Test include_patterns
        {
            string extractDir = testDir + "/filter_include";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "include_patterns": ("*.txt",),
            });

            assertEq(True, response.success, "filter include: success");
            assertEq(True, response.entry_count > 0, "filter include: entries extracted");
            assertEq(True, response.skipped_count > 0, "filter include: entries skipped");
            assertEq(True, is_file(extractDir + "/readme.txt"), "filter include: readme.txt extracted");
            assertEq(True, is_file(extractDir + "/temp_notes.txt"), "filter include: temp_notes.txt extracted");
            assertEq(False, is_file(extractDir + "/src/main.cpp"), "filter include: main.cpp not extracted");
            assertEq(False, is_file(extractDir + "/data/report.csv"), "filter include: report.csv not extracted");
        }

        # Test exclude_patterns
        {
            string extractDir = testDir + "/filter_exclude";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "exclude_patterns": ("*.log", "temp_*"),
            });

            assertEq(True, response.success, "filter exclude: success");
            assertEq(True, response.skipped_count > 0, "filter exclude: entries skipped");
            assertEq(True, is_file(extractDir + "/readme.txt"), "filter exclude: readme.txt extracted");
            assertEq(False, is_file(extractDir + "/data/report.log"), "filter exclude: .log not extracted");
            assertEq(False, is_file(extractDir + "/temp_notes.txt"), "filter exclude: temp_* not extracted");
        }

        # Test include_regex
        {
            string extractDir = testDir + "/filter_inc_regex";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "include_regex": "^src/",
            });

            assertEq(True, response.success, "filter include_regex: success");
            assertEq(True, is_file(extractDir + "/src/main.cpp"), "filter include_regex: main.cpp extracted");
            assertEq(True, is_file(extractDir + "/src/util.cpp"), "filter include_regex: util.cpp extracted");
            assertEq(False, is_file(extractDir + "/readme.txt"), "filter include_regex: readme.txt not extracted");
        }

        # Test combined include + exclude
        {
            string extractDir = testDir + "/filter_combined";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "include_patterns": ("*.txt",),
                "exclude_patterns": ("temp_*",),
            });

            assertEq(True, is_file(extractDir + "/readme.txt"),
                "filter combined: readme.txt included");
            assertEq(False, is_file(extractDir + "/temp_notes.txt"),
                "filter combined: temp_notes.txt excluded by blacklist");
        }

        # Test filters that match nothing
        {
            string extractDir = testDir + "/filter_nomatch";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "include_patterns": ("*.xyz",),
            });

            assertEq(0, response.entry_count, "filter nomatch: 0 entries extracted");
        }
    }

    filterListTest() {
        ZipDataProvider factory();
        binary archive_data = createFilterTestArchive();

        # Test list with include_patterns
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "include_patterns": ("*.cpp",),
            });

            assertEq(2, response.count, "list filter: 2 cpp files");
            foreach hash<auto> entry in (response.entries) {
                assertEq(True, entry.name =~ /\.cpp$/, "list filter: entry is .cpp");
            }
        }

        # Test list with exclude_regex
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "exclude_regex": "\\.(log|csv)$",
            });

            foreach hash<auto> entry in (response.entries) {
                assertEq(False, entry.name =~ /\.(log|csv)$/, "list exclude_regex: no log/csv entries");
            }
        }

        # Test list with no filters (backward compat)
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("list");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
            });

            assertEq(True, response.count >= 7, "list no filter: all entries returned");
        }
    }

    filterDecompressTest() {
        ZipDataProvider factory();
        binary archive_data = createFilterTestArchive();

        # Test decompress with include_patterns
        {
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "include_patterns": ("*.txt",),
            });

            assertEq(2, response.entry_count, "decompress filter: 2 txt entries");
            assertEq(True, exists response.entries."readme.txt", "decompress filter: has readme.txt");
            assertEq(True, exists response.entries."temp_notes.txt", "decompress filter: has temp_notes.txt");
            assertEq(False, exists response.entries."src/main.cpp", "decompress filter: no main.cpp");
        }

        # Test decompress with exclude_patterns + entry_names combined
        {
            AbstractDataProvider dp = factory.getChildProviderEx("data").getChildProviderEx("decompress");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "entry_names": ("readme.txt", "temp_notes.txt", "src/main.cpp"),
                "exclude_patterns": ("temp_*",),
            });

            assertEq(2, response.entry_count, "decompress combined: 2 entries");
            assertEq(True, exists response.entries."readme.txt", "decompress combined: has readme.txt");
            assertEq(True, exists response.entries."src/main.cpp", "decompress combined: has main.cpp");
            assertEq(False, exists response.entries."temp_notes.txt",
                "decompress combined: temp_notes.txt excluded");
        }
    }

    filterInfoTest() {
        ZipDataProvider factory();
        binary archive_data = createFilterTestArchive();

        # Test info with filter
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("info");
            hash<auto> all_info = dp.doRequest({
                "data": archive_data,
            });

            hash<auto> filtered_info = dp.doRequest({
                "data": archive_data,
                "include_patterns": ("*.txt",),
            });

            assertEq(True, filtered_info.entry_count < all_info.entry_count,
                "info filter: fewer entries");
            assertEq(True, filtered_info.total_size < all_info.total_size,
                "info filter: smaller total size");
        }
    }

    extractOptionsTest() {
        ZipDataProvider factory();

        # Create archive with paths
        ZipFile zip();
        zip.addDirectory("src/");
        zip.addText("src/main.cpp", "int main() {}");
        zip.addText("src/util.cpp", "void util() {}");
        binary archive_data = zip.toData();

        # Test strip_prefix
        {
            string extractDir = testDir + "/dp_strip_prefix";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "strip_prefix": "src/",
            });

            assertEq(True, response.success, "strip_prefix: success");
            assertEq(True, is_file(extractDir + "/main.cpp"), "strip_prefix: main.cpp at root");
            assertEq(True, is_file(extractDir + "/util.cpp"), "strip_prefix: util.cpp at root");
        }

        # Test preserve_paths=False
        {
            string extractDir = testDir + "/dp_flat";
            mkdir(extractDir);

            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("extract");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "destination": extractDir,
                "preserve_paths": False,
            });

            assertEq(True, response.success, "preserve_paths=False: success");
            assertEq(True, is_file(extractDir + "/main.cpp"), "preserve_paths=False: main.cpp flat");
        }
    }

    addPathActionTest() {
        ZipDataProvider factory();

        # Create source directory
        string srcDir = testDir + "/dp_addpath_src";
        mkdir(srcDir);
        {
            File f();
            f.open2(srcDir + "/hello.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("Hello from addPath");
        }

        string zipPath = testDir + "/dp_addpath.zip";

        # First create an empty archive
        {
            ZipFile zip(zipPath, "w");
            zip.addText("existing.txt", "existing");
            zip.close();
        }

        # Test add-path action
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("add-path");
            hash<auto> response = dp.doRequest({
                "archive_path": zipPath,
                "source_path": srcDir,
                "root_path": dirname(srcDir),
            });

            assertEq(True, response.success, "add-path: success");
        }

        # Verify archive contents
        {
            ZipFile zip(zipPath, "r");
            list<hash<ZipEntryInfo>> entries = zip.entries();
            assertEq(True, entries.size() >= 2, "add-path: archive has entries");

            bool found = False;
            foreach hash<ZipEntryInfo> entry in (entries) {
                if (entry.name =~ /hello\.txt$/) {
                    found = True;
                    binary data = zip.read(entry.name);
                    assertEq("Hello from addPath", data.toString(), "add-path: content matches");
                }
            }
            assertEq(True, found, "add-path: hello.txt in archive");
            zip.close();
        }
    }

    verifyActionTest() {
        ZipDataProvider factory();

        # Create test archive
        ZipFile zip();
        zip.addText("valid1.txt", "content 1");
        zip.addText("valid2.txt", "content 2");
        binary archive_data = zip.toData();

        # Test verify via data provider
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("verify");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
            });

            assertEq(True, response.valid, "verify dp: all valid");
            assertEq(2, response.verified_count, "verify dp: 2 entries verified");
            assertEq(0, response.failed_count, "verify dp: 0 failures");
            assertEq(2, response.results.size(), "verify dp: 2 results");
            assertEq(True, response.results[0].valid, "verify dp: first entry valid");
        }

        # Test verify with filter
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("verify");
            hash<auto> response = dp.doRequest({
                "data": archive_data,
                "include_patterns": ("*1*",),
            });

            assertEq(1, response.verified_count, "verify dp filtered: 1 entry");
            assertEq(True, response.valid, "verify dp filtered: valid");
        }
    }

    replaceActionTest() {
        ZipDataProvider factory();

        # Create test archive
        string zipPath = testDir + "/dp_replace_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("keep.txt", "keep");
            zip.addText("replace.txt", "old");
            zip.addText("remove.txt", "remove");
            zip.close();
        }

        # Test replace via data provider
        {
            AbstractDataProvider dp = factory.getChildProviderEx("archive").getChildProviderEx("replace");
            hash<auto> response = dp.doRequest({
                "archive_path": zipPath,
                "replacements": {"replace.txt": binary("new content")},
                "delete_names": ("remove.txt",),
            });

            assertEq(True, response.success, "replace dp: success");
            assertEq(1, response.replaced_count, "replace dp: 1 replaced");
            assertEq(1, response.deleted_count, "replace dp: 1 deleted");
            assertEq(1, response.copied_count, "replace dp: 1 copied");
        }

        # Verify the result
        {
            ZipFile zip(zipPath, "r");
            assertEq(2, zip.count(), "replace dp result: 2 entries");
            assertEq("keep", zip.readText("keep.txt"), "replace dp result: keep.txt intact");
            assertEq("new content", zip.readText("replace.txt"),
                "replace dp result: replace.txt updated");
            assertEq(False, zip.hasEntry("remove.txt"),
                "replace dp result: remove.txt gone");
            zip.close();
        }
    }
}
