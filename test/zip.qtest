        }
    }

    pathRemappingTest() {
        string zipPath = testDir + "/remap_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addDirectory("src/");
            zip.addText("src/main.cpp", "main");
            zip.addText("src/util.cpp", "util");
            zip.addText("readme.txt", "readme");
            zip.close();
        }

        # Test strip_prefix
        {
            string extractDir = testDir + "/strip_prefix";
            mkdir(extractDir);

            ZipFile zip(zipPath, "r");
            zip.extractEntries(extractDir, ("src/main.cpp", "src/util.cpp"),
                <ZipExtractOptions>{"strip_prefix": "src/"});
            zip.close();

            assertEq(True, is_file(extractDir + "/main.cpp"), "strip_prefix: main.cpp extracted");
            assertEq(True, is_file(extractDir + "/util.cpp"), "strip_prefix: util.cpp extracted");
            assertEq(False, is_dir(extractDir + "/src"), "strip_prefix: src/ dir not created");
        }

        # Test add_prefix
        {
            string extractDir = testDir + "/add_prefix";
            mkdir(extractDir);

            ZipFile zip(zipPath, "r");
            zip.extractEntries(extractDir, ("readme.txt",),
                <ZipExtractOptions>{"add_prefix": "output"});
            zip.close();

            assertEq(True, is_file(extractDir + "/output/readme.txt"),
                "add_prefix: file under output/");
        }

        # Test strip_prefix + add_prefix combined
        {
            string extractDir = testDir + "/combined_remap";
            mkdir(extractDir);

            ZipFile zip(zipPath, "r");
            zip.extractEntries(extractDir, ("src/main.cpp",),
                <ZipExtractOptions>{"strip_prefix": "src/", "add_prefix": "build/"});
            zip.close();

            assertEq(True, is_file(extractDir + "/build/main.cpp"),
                "combined remap: src/main.cpp -> build/main.cpp");
        }
    }

    entryCallbackTest() {
        string zipPath = testDir + "/callback_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("a.txt", "A");
            zip.addText("b.txt", "B");
            zip.addText("c.txt", "C");
            zip.close();
        }

        # Test entry callback with extractAll
        {
            string extractDir = testDir + "/callback_extract";
            mkdir(extractDir);

            list<string> callback_entries = ();
            code<nothing(string)> cb = sub (string name) {
                callback_entries += name;
            };

            ZipFile zip(zipPath, "r");
            zip.extractAll(extractDir, <ZipExtractOptions>{"entry_callback": cb});
            zip.close();

            assertEq(3, callback_entries.size(), "callback called 3 times");
            assertEq(True, inlist("a.txt", callback_entries), "callback received a.txt");
            assertEq(True, inlist("b.txt", callback_entries), "callback received b.txt");
            assertEq(True, inlist("c.txt", callback_entries), "callback received c.txt");
        }

        # Test entry callback with extractEntries
        {
            string extractDir = testDir + "/callback_extract_entries";
            mkdir(extractDir);

            list<string> callback_entries = ();
            code<nothing(string)> cb = sub (string name) {
                callback_entries += name;
            };

            ZipFile zip(zipPath, "r");
            zip.extractEntries(extractDir, ("a.txt", "c.txt"),
                <ZipExtractOptions>{"entry_callback": cb});
            zip.close();

            assertEq(2, callback_entries.size(), "callback called for 2 entries");
            assertEq(True, inlist("a.txt", callback_entries), "callback received a.txt");
            assertEq(True, inlist("c.txt", callback_entries), "callback received c.txt");
        }
    }

    addPathTest() {
        # Create a directory structure to add
        string srcDir = testDir + "/addpath_src";
        mkdir(srcDir);
        mkdir(srcDir + "/subdir");
        {
            File f();
            f.open2(srcDir + "/file1.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("File 1");
        }
        {
            File f();
            f.open2(srcDir + "/subdir/file2.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("File 2");
        }

        # Test addPath
        string zipPath = testDir + "/addpath_test.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addPath(srcDir, dirname(srcDir));
            zip.close();
        }

        # Verify the archive has the correct entries
        {
            ZipFile zip(zipPath, "r");
            list<hash<ZipEntryInfo>> entries = zip.entries();
            assertEq(True, entries.size() >= 2, "addPath added files");

            # Verify we can read content
            bool found = False;
            foreach hash<ZipEntryInfo> entry in (entries) {
                if (entry.name =~ /file1\.txt$/) {
                    binary data = zip.read(entry.name);
                    assertEq("File 1", data.toString(), "addPath file content matches");
                    found = True;
                }
            }
            assertEq(True, found, "file1.txt found in archive");
            zip.close();
        }
    }

    symlinkSecurityTest() {
        # Test 1: Symlinks skipped by default
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("safe.txt", "safe content");
                zip.addSymlink("escape_link", "../../etc/passwd");
                zip.addText("other.txt", "other content");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_default";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            zip.extractAll(extractDir);
            zip.close();

            assertEq(True, is_file(extractDir + "/safe.txt"), "safe.txt extracted");
            assertEq(True, is_file(extractDir + "/other.txt"), "other.txt extracted");
            assertEq(False, is_link(extractDir + "/escape_link"),
                "symlink skipped by default");
        }

        # Test 2: Absolute symlink target skipped by default
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("normal.txt", "normal");
                zip.addSymlink("abs_link", "/etc/passwd");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_abs";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            zip.extractAll(extractDir);
            zip.close();

            assertEq(True, is_file(extractDir + "/normal.txt"), "normal.txt extracted");
            assertEq(False, is_link(extractDir + "/abs_link"),
                "absolute symlink skipped by default");
        }

        # Test 3: Safe symlink allowed with allow_symlinks=True
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("target.txt", "target content");
                zip.addSymlink("safe_link", "target.txt");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_safe";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            zip.extractAll(extractDir, <ZipExtractOptions>{"allow_symlinks": True});
            zip.close();

            assertEq(True, is_file(extractDir + "/target.txt"), "target.txt extracted");
            assertEq(True, is_link(extractDir + "/safe_link"), "safe symlink created");
            # Verify the symlink target is correct
            string link_target = readlink(extractDir + "/safe_link");
            assertEq("target.txt", link_target, "symlink target is correct");
        }

        # Test 4: Escape symlink rejected with allow_symlinks=True
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addSymlink("escape", "../../outside");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_escape";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            try {
                zip.extractAll(extractDir, <ZipExtractOptions>{"allow_symlinks": True});
                assertEq(True, False, "should have thrown");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("ZIP-SECURITY-ERROR", ex.err,
                    "escape symlink raises ZIP-SECURITY-ERROR");
            }
            zip.close();
        }

        # Test 5: Absolute target rejected with allow_symlinks=True
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addSymlink("abs_escape", "/etc/passwd");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_abs_escape";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            try {
                zip.extractAll(extractDir, <ZipExtractOptions>{"allow_symlinks": True});
                assertEq(True, False, "should have thrown");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("ZIP-SECURITY-ERROR", ex.err,
                    "absolute symlink raises ZIP-SECURITY-ERROR");
            }
            zip.close();
        }

        # Test 6: extractEntries also skips symlinks by default
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("file.txt", "content");
                zip.addSymlink("link", "../escape");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_entries";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            list<string> files = zip.extractEntries(extractDir, ("file.txt", "link"));
            zip.close();

            assertEq(1, files.size(), "only file extracted, symlink skipped");
            assertEq(False, is_link(extractDir + "/link"),
                "extractEntries skips symlinks by default");
        }

        # Test 7: Symlink loop entries — both skipped by default
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addSymlink("a", "b");
                zip.addSymlink("b", "a");
                zip.addText("safe.txt", "safe");
                archive_data = zip.toData();
            }

            string extractDir = testDir + "/symlink_loop";
            mkdir(extractDir);

            ZipFile zip(archive_data);
            zip.extractAll(extractDir);
            zip.close();

            assertEq(True, is_file(extractDir + "/safe.txt"), "safe.txt extracted despite loop entries");
            assertEq(False, is_link(extractDir + "/a"), "loop symlink a skipped");
            assertEq(False, is_link(extractDir + "/b"), "loop symlink b skipped");
        }
    }

    verifyTest() {
        # Test verify on valid archive
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("file1.txt", "content 1");
                zip.addText("file2.txt", "content 2");
                zip.addDirectory("dir/");
                archive_data = zip.toData();
            }

            ZipFile zip(archive_data);
            list<hash<ZipVerifyResult>> results = zip.verify();
            zip.close();

            assertEq(2, results.size(), "verify: 2 file entries verified (dirs skipped)");
            assertEq(True, results[0].valid, "verify: file1.txt valid");
            assertEq(True, results[1].valid, "verify: file2.txt valid");
        }

        # Test verify with password
        {
            binary archive_data;
            {
                ZipFile zip();
                zip.addText("secret.txt", "secret data", NOTHING,
                    <ZipAddOptions>{"password": "test123"});
                archive_data = zip.toData();
            }

            ZipFile zip(archive_data);
            list<hash<ZipVerifyResult>> results = zip.verify(
                <ZipExtractOptions>{"password": "test123"});
            zip.close();

            assertEq(1, results.size(), "verify encrypted: 1 entry");
            assertEq(True, results[0].valid, "verify encrypted: valid with correct password");
        }
    }

    replaceDeleteTest() {
        # Test delete
        {
            string zipPath = testDir + "/replace_delete_test.zip";
            {
                ZipFile zip(zipPath, "w");
                zip.addText("keep.txt", "keep");
                zip.addText("remove.txt", "remove");
                zip.addText("also_keep.txt", "also keep");
                zip.close();
            }

            hash<auto> result = ZipFile::replaceEntries(zipPath, NOTHING, ("remove.txt",));
            assertEq(True, result.success, "delete: success");
            assertEq(1, result.deleted_count, "delete: 1 deleted");
            assertEq(2, result.copied_count, "delete: 2 copied");

            ZipFile zip(zipPath, "r");
            assertEq(2, zip.count(), "delete: 2 entries remain");
            assertEq(False, zip.hasEntry("remove.txt"), "delete: remove.txt gone");
            assertEq("keep", zip.readText("keep.txt"), "delete: keep.txt intact");
            zip.close();
        }

        # Test replace
        {
            string zipPath = testDir + "/replace_test2.zip";
            {
                ZipFile zip(zipPath, "w");
                zip.addText("config.txt", "old config");
                zip.addText("data.bin", "old data");
                zip.close();
            }

            hash<auto> result = ZipFile::replaceEntries(zipPath,
                {"config.txt": binary("new config")});
            assertEq(True, result.success, "replace: success");
            assertEq(1, result.replaced_count, "replace: 1 replaced");
            assertEq(1, result.copied_count, "replace: 1 copied");

            ZipFile zip(zipPath, "r");
            assertEq("new config", zip.readText("config.txt"), "replace: content updated");
            assertEq("old data", zip.readText("data.bin"), "replace: other entry unchanged");
            zip.close();
        }

        # Test combined replace + delete
        {
            string zipPath = testDir + "/replace_delete_combo.zip";
            {
                ZipFile zip(zipPath, "w");
                zip.addText("a.txt", "a");
                zip.addText("b.txt", "b");
                zip.addText("c.txt", "c");
                zip.close();
            }

            hash<auto> result = ZipFile::replaceEntries(zipPath,
                {"b.txt": binary("new b")},
                ("c.txt",));
            assertEq(1, result.replaced_count, "combo: 1 replaced");
            assertEq(1, result.deleted_count, "combo: 1 deleted");
            assertEq(1, result.copied_count, "combo: 1 copied");

            ZipFile zip(zipPath, "r");
            assertEq(2, zip.count(), "combo: 2 entries remain");
            assertEq("a", zip.readText("a.txt"), "combo: a.txt unchanged");
            assertEq("new b", zip.readText("b.txt"), "combo: b.txt replaced");
            zip.close();
        }
    }

    enhancedEntryInfoTest() {
        # Test permissions and created_by_system from filesystem archive
        {
            string srcDir = testDir + "/entryinfo_src";
            mkdir(srcDir);
            {
                File f();
                f.open2(srcDir + "/file.txt", O_CREAT | O_WRONLY | O_TRUNC);
                f.write("test");
            }

            ZipFile zip();
            zip.addPath(srcDir, dirname(srcDir));
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            readZip.close();

            bool found_file = False;
            foreach hash<ZipEntryInfo> entry in (entries) {
                if (entry.name =~ /file\.txt$/) {
                    found_file = True;
                    assertEq(True, entry.permissions >= 0, "permissions available");
                    assertEq(True, (entry.permissions & 0400) > 0, "owner read permission set");
                    assertEq(False, entry.is_symlink, "regular file is not symlink");
                    assertEq(True, entry.created_by_system >= 0, "created_by_system set");
                    assertEq(0, entry.encryption_method, "no encryption");
                }
            }
            assertEq(True, found_file, "file.txt found in entries");
        }

        # Test symlink entry info
        {
            ZipFile zip();
            zip.addText("target.txt", "target");
            zip.addSymlink("link", "target.txt");
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            readZip.close();

            hash<ZipEntryInfo> link_entry;
            foreach hash<ZipEntryInfo> entry in (entries) {
                if (entry.name == "link") {
                    link_entry = entry;
                }
            }
            assertEq(True, link_entry.is_symlink, "symlink entry detected");
            assertEq(True, link_entry.permissions >= 0, "symlink has permissions");
        }

        # Test encryption method in entry info
        {
            ZipFile zip();
            zip.addText("encrypted.txt", "secret", NOTHING,
                <ZipAddOptions>{"password": "test123"});
            zip.addText("plain.txt", "plain");
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            readZip.close();

            foreach hash<ZipEntryInfo> entry in (entries) {
                if (entry.name == "encrypted.txt") {
                    assertEq(True, entry.is_encrypted, "encrypted entry detected");
                    assertEq(True, entry.encryption_method > 0,
                        "encryption method set for encrypted entry");
                } else if (entry.name == "plain.txt") {
                    assertEq(False, entry.is_encrypted, "plain entry not encrypted");
                    assertEq(0, entry.encryption_method,
                        "encryption method is 0 for plain entry");
                }
            }
        }
    }

    encryptionMethodTest() {
        # Test PKWARE encryption
        {
            ZipFile zip();
            zip.addText("pkware.txt", "pkware data", NOTHING,
                <ZipAddOptions>{"password": "test", "encryption_method": ZIP_EM_TRAD_PKWARE});
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            assertEq(True, entries[0].is_encrypted, "PKWARE entry is encrypted");
            assertEq(ZIP_EM_TRAD_PKWARE, entries[0].encryption_method,
                "PKWARE encryption method detected");
            readZip.close();

            # Verify can be extracted with correct password
            string extractDir = testDir + "/pkware_extract";
            mkdir(extractDir);
            ZipFile extractZip(archive_data);
            extractZip.extractAll(extractDir, <ZipExtractOptions>{"password": "test"});
            extractZip.close();
            string content = ReadOnlyFile::readTextFile(extractDir + "/pkware.txt");
            assertEq("pkware data", content, "PKWARE encrypted content readable");
        }

        # Test AES-256 explicit
        {
            ZipFile zip();
            zip.addText("aes256.txt", "aes data", NOTHING,
                <ZipAddOptions>{"password": "test", "encryption_method": ZIP_EM_AES_256});
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            assertEq(ZIP_EM_AES_256, entries[0].encryption_method,
                "AES-256 encryption method detected");
            readZip.close();
        }

        # Test default (no encryption_method = PKWARE for Windows interop)
        # Default is traditional PKWARE ZipCrypto because it is what Windows Explorer's built-in
        # ZIP handler, macOS Finder, and most common tools support out of the box. Users must
        # explicitly request AES when they need strong encryption.
        {
            ZipFile zip();
            zip.addText("default.txt", "default data", NOTHING,
                <ZipAddOptions>{"password": "test"});
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            list<hash<ZipEntryInfo>> entries = readZip.entries();
            assertEq(ZIP_EM_TRAD_PKWARE, entries[0].encryption_method,
                "default encryption is PKWARE (interop-first)");
            readZip.close();
        }

        # ZIP_EM_NONE: password provided but encryption explicitly disabled → entry is stored plain
        {
            ZipFile zip();
            zip.addText("plain.txt", "plain data", NOTHING,
                <ZipAddOptions>{"password": "ignored", "encryption_method": ZIP_EM_NONE});
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            hash<ZipEntryInfo> e = readZip.getEntry("plain.txt");
            assertEq(False, e.is_encrypted, "ZIP_EM_NONE disables encryption even with password");
            assertEq(0, e.encryption_method, "no encryption method set when disabled");
            # Must be readable without supplying a password
            assertEq("plain data", readZip.readText("plain.txt"), "plain entry readable with no pwd");
            readZip.close();
        }

        # AES-128 and AES-192 round-trip via in-memory add()
        string payload = strmul("x", 100);
        foreach hash<auto> tc in ((
            {"em": ZIP_EM_AES_128, "name": "aes-128"},
            {"em": ZIP_EM_AES_192, "name": "aes-192"},
        )) {
            ZipFile zip();
            zip.addText("data.txt", payload, NOTHING,
                <ZipAddOptions>{"password": "p", "encryption_method": tc.em});
            binary archive_data = zip.toData();

            ZipFile readZip(archive_data);
            hash<ZipEntryInfo> e = readZip.getEntry("data.txt");
            assertEq(tc.em, e.encryption_method, tc.name + " encryption method round-trips");
            readZip.setPassword("p");
            assertEq(payload, readZip.readText("data.txt"), tc.name + " content round-trips");
            readZip.close();
        }

        # addFile() with PKWARE → interop-friendly file-based archive
        {
            string srcPath = testDir + "/pkware_src.txt";
            File f();
            f.open2(srcPath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("pkware file content");
            f.close();

            string zipPath = testDir + "/pkware_file.zip";
            ZipFile zip(zipPath, "w");
            zip.addFile("src.txt", srcPath, <ZipAddOptions>{"password": "pw"});
            zip.close();

            ZipFile readZip(zipPath, "r");
            hash<ZipEntryInfo> e = readZip.getEntry("src.txt");
            assertEq(ZIP_EM_TRAD_PKWARE, e.encryption_method,
                "addFile uses PKWARE default for interop");
            readZip.close();
        }
    }

    # Missing-password handling: extract/read/verify/extractEntry/extractEntries all raise
    # ZIP-PASSWORD-ERROR *before* opening the destination file. Previously minizip-ng would create
    # the file and then fail with a cryptic decompressor error, leaving 0-byte garbage.
    missingPasswordTest() {
        string zipPath = testDir + "/missing_pwd.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("plain.txt", "plain content");
            zip.addText("secret.txt", "secret content", NOTHING,
                <ZipAddOptions>{"password": "pw"});
            zip.close();
        }

        # extractAll without password → ZIP-PASSWORD-ERROR, no files created
        {
            string extractDir = testDir + "/missing_pwd_extract";
            mkdir(extractDir);
            bool caught = False;
            ZipFile zip(zipPath, "r");
            try {
                zip.extractAll(extractDir);
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("ZIP-PASSWORD-ERROR", ex.err,
                    "extractAll without password raises ZIP-PASSWORD-ERROR");
                assertEq(True, ex.desc =~ /secret\.txt/,
                    "error names the encrypted entry");
            }
            zip.close();
            assertEq(True, caught, "extractAll without password threw");
            # Critical invariant: the pre-check must run before any I/O — no partial files left.
            assertEq(False, is_file(extractDir + "/secret.txt"),
                "no 0-byte secret.txt written before failure");
            assertEq(False, is_file(extractDir + "/plain.txt"),
                "plain.txt not extracted either (whole operation aborts cleanly)");
        }

        # extractEntry of encrypted entry without password → ZIP-PASSWORD-ERROR, no file
        {
            string outPath = testDir + "/missing_pwd_entry.out";
            bool caught = False;
            ZipFile zip(zipPath, "r");
            try {
                zip.extractEntry("secret.txt", outPath);
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("ZIP-PASSWORD-ERROR", ex.err, "extractEntry raises ZIP-PASSWORD-ERROR");
            }
            zip.close();
            assertEq(True, caught, "extractEntry without password threw");
            assertEq(False, is_file(outPath), "no output file left on disk");
        }

        # extractEntries of encrypted entry without password → ZIP-PASSWORD-ERROR, no file
        {
            string extractDir = testDir + "/missing_pwd_entries";
            mkdir(extractDir);
            bool caught = False;
            ZipFile zip(zipPath, "r");
            try {
                zip.extractEntries(extractDir, ("secret.txt",));
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("ZIP-PASSWORD-ERROR", ex.err, "extractEntries raises ZIP-PASSWORD-ERROR");
            }
            zip.close();
            assertEq(True, caught, "extractEntries without password threw");
            assertEq(False, is_file(extractDir + "/secret.txt"), "no 0-byte file written");
        }

        # extractEntries of ONLY plain entries on a mixed archive → succeeds (doesn't false-positive
        # on encrypted entries we aren't asking for)
        {
            string extractDir = testDir + "/missing_pwd_plainonly";
            mkdir(extractDir);
            ZipFile zip(zipPath, "r");
            list<string> out = zip.extractEntries(extractDir, ("plain.txt",));
            zip.close();
            assertEq(1, out.size(), "plain-only extraction skips encrypted-entry check");
            assertEq("plain content",
                ReadOnlyFile::readTextFile(extractDir + "/plain.txt"),
                "plain content extracted");
        }

        # read() of encrypted entry without password → ZIP-PASSWORD-ERROR
        {
            bool caught = False;
            ZipFile zip(zipPath, "r");
            try {
                zip.readText("secret.txt");
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("ZIP-PASSWORD-ERROR", ex.err, "read raises ZIP-PASSWORD-ERROR");
            }
            zip.close();
            assertEq(True, caught, "readText without password threw");
        }

        # verify() on encrypted archive without password → ZIP-PASSWORD-ERROR (can't integrity-check)
        {
            bool caught = False;
            ZipFile zip(zipPath, "r");
            try {
                zip.verify();
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("ZIP-PASSWORD-ERROR", ex.err, "verify raises ZIP-PASSWORD-ERROR");
            }
            zip.close();
            assertEq(True, caught, "verify without password threw");
        }
    }

    # ZipExtractResult: extractAll returns a hash describing extracted vs. skipped entries.
    # Also covers the bug where overwrite-denied files used to be reported as "extracted".
    extractResultTest() {
        string zipPath = testDir + "/extract_result.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("a.txt", "A");
            zip.addText("b.txt", "B");
            zip.addText("c.txt", "C");
            zip.close();
        }

        # Fresh dir → everything extracted, nothing skipped
        {
            string extractDir = testDir + "/extract_result_fresh";
            mkdir(extractDir);
            ZipFile zip(zipPath, "r");
            hash<ZipExtractResult> r = zip.extractAll(extractDir);
            zip.close();

            assertEq(3, r.extracted_count, "all 3 extracted");
            assertEq(0, r.skipped_count, "none skipped on fresh dir");
            assertEq(3, r.extracted.size(), "extracted list matches count");
            assertEq((), r.skipped, "skipped list is empty");
        }

        # Pre-existing b.txt + no overwrite → b.txt in skipped, a/c in extracted
        {
            string extractDir = testDir + "/extract_result_conflict";
            mkdir(extractDir);
            File f();
            f.open2(extractDir + "/b.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("old B");
            f.close();

            ZipFile zip(zipPath, "r");
            hash<ZipExtractResult> r = zip.extractAll(extractDir);
            zip.close();

            assertEq(2, r.extracted_count, "2 extracted (a, c)");
            assertEq(1, r.skipped_count, "1 skipped (b)");
            assertEq(True, r.skipped[0] =~ /b\.txt/, "skipped path is b.txt");
            # Skipped file content must be preserved
            assertEq("old B", ReadOnlyFile::readTextFile(extractDir + "/b.txt"),
                "skipped file keeps original content");
        }

        # Pre-existing b.txt + overwrite=True → all extracted, nothing skipped, old content replaced
        {
            string extractDir = testDir + "/extract_result_overwrite";
            mkdir(extractDir);
            File f();
            f.open2(extractDir + "/b.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("old B");
            f.close();

            ZipFile zip(zipPath, "r");
            hash<ZipExtractResult> r = zip.extractAll(extractDir,
                <ZipExtractOptions>{"overwrite": True});
            zip.close();

            assertEq(3, r.extracted_count, "all 3 extracted with overwrite=True");
            assertEq(0, r.skipped_count, "none skipped with overwrite=True");
            assertEq("B", ReadOnlyFile::readTextFile(extractDir + "/b.txt"),
                "b.txt replaced with new content");
        }

        # 0-byte existing file → still counted as skipped (regression: matches the qzip bug report
        # where the user's 0-byte leftovers were silently left in place)
        {
            string extractDir = testDir + "/extract_result_zerobyte";
            mkdir(extractDir);
            File f();
            f.open2(extractDir + "/a.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.close();  # 0-byte

            ZipFile zip(zipPath, "r");
            hash<ZipExtractResult> r = zip.extractAll(extractDir);
            zip.close();

            assertEq(1, r.skipped_count, "0-byte existing file is skipped like any other");
            assertEq(0, hstat(extractDir + "/a.txt").size, "0-byte file unchanged");
        }
    }

    # Regression: extractEntries used to push overwrite-denied files into the returned "extracted"
    # list because minizip-ng returns MZ_OK when the overwrite callback denies a write.
    extractEntriesSkipReturnTest() {
        string zipPath = testDir + "/ee_skip.zip";
        {
            ZipFile zip(zipPath, "w");
            zip.addText("x.txt", "new-X");
            zip.addText("y.txt", "new-Y");
            zip.close();
        }

        string extractDir = testDir + "/ee_skip_dir";
        mkdir(extractDir);
        File f();
        f.open2(extractDir + "/x.txt", O_CREAT | O_WRONLY | O_TRUNC);
        f.write("old-X");
        f.close();

        ZipFile zip(zipPath, "r");
        list<string> out = zip.extractEntries(extractDir, ("x.txt", "y.txt"));
        zip.close();

        assertEq(1, out.size(),
            "extractEntries returns only entries actually written (x was skipped)");
        assertEq(True, out[0] =~ /y\.txt/, "returned entry is y.txt, not x.txt");
        assertEq("old-X", ReadOnlyFile::readTextFile(extractDir + "/x.txt"),
            "x.txt content preserved (skip honored)");
        assertEq("new-Y", ReadOnlyFile::readTextFile(extractDir + "/y.txt"),
            "y.txt was extracted");
    }

    # recompress now supports choosing the encryption method when rewriting an encrypted archive.
    recompressEncryptionTest() {
        # Create AES-256 source, recompress with PKWARE output → content intact, method changed
        string src = testDir + "/rc_aes.zip";
        {
            ZipFile zip(src, "w");
            zip.addText("a.txt", "recompress me", NOTHING,
                <ZipAddOptions>{"password": "p", "encryption_method": ZIP_EM_AES_256});
            zip.close();
        }

        ZipFile::recompress(src, ZIP_CM_DEFLATE, 6, "p", ZIP_EM_TRAD_PKWARE);

        {
            ZipFile zip(src, "r");
            hash<ZipEntryInfo> e = zip.getEntry("a.txt");
            assertEq(ZIP_EM_TRAD_PKWARE, e.encryption_method,
                "recompress rewrote as PKWARE per explicit encryption_method");
            zip.setPassword("p");
            assertEq("recompress me", zip.readText("a.txt"),
                "recompressed content decryptable with original password");
            zip.close();
        }

        # No explicit encryption_method + password → PKWARE default (matches add())
        string src2 = testDir + "/rc_default.zip";
        {
            ZipFile zip(src2, "w");
            zip.addText("a.txt", "data", NOTHING,
                <ZipAddOptions>{"password": "p", "encryption_method": ZIP_EM_AES_256});
            zip.close();
        }
        ZipFile::recompress(src2, ZIP_CM_DEFLATE, 6, "p");
        {
            ZipFile zip(src2, "r");
            hash<ZipEntryInfo> e = zip.getEntry("a.txt");
            assertEq(ZIP_EM_TRAD_PKWARE, e.encryption_method,
                "recompress default encryption method is PKWARE (interop-first)");
            zip.close();
        }
    }

    setPasswordTest() {
        string secret = "MyPassword123";
        string content = "encrypted content";

        # Create encrypted in-memory archive
        binary archive_data;
        {
            ZipFile zip();
            zip.addText("secret.txt", content, NOTHING, <ZipAddOptions>{"password": secret});
            archive_data = zip.toData();
        }

        # Test: readText without password returns wrong content or throws
        {
            ZipFile zip(archive_data);
            *string result;
            bool threw = False;
            try {
                result = zip.readText("secret.txt");
            } catch () {
                threw = True;
            }
            assertEq(True, threw || result != content,
                "read without password fails or returns wrong content");
            zip.close();
        }

        # Test: readText succeeds after setPassword
        {
            ZipFile zip(archive_data);
            zip.setPassword(secret);
            string result = zip.readText("secret.txt");
            assertEq(content, result, "readText works after setPassword");
            zip.close();
        }

        # Test: clear password with NOTHING
        {
            ZipFile zip(archive_data);
            zip.setPassword(secret);
            zip.setPassword();  # clear
            *string result;
            bool threw = False;
            try {
                result = zip.readText("secret.txt");
            } catch () {
                threw = True;
            }
            assertEq(True, threw || result != content,
                "read after clearing password fails or returns wrong content");
            zip.close();
        }

        # Test: openRead (streaming) works with setPassword
        {
            ZipFile zip(archive_data);
            zip.setPassword(secret);
            {
                ZipInputStream is = zip.openRead("secret.txt");
                binary data = is.read(65536);
                assertEq(content, data.toString(), "streaming read works after setPassword");
            }
            zip.close();
        }
    }

    diffTest() {
        # Create two archives with overlapping entries
        string path1 = testDir + "/diff1.zip";
        string path2 = testDir + "/diff2.zip";
        {
            ZipFile zip(path1, "w");
            zip.addText("same.txt", "same content");
            zip.addText("modified.txt", "old content");
            zip.addText("deleted.txt", "will be deleted");
            zip.close();
        }
        {
            ZipFile zip(path2, "w");
            zip.addText("same.txt", "same content");
            zip.addText("modified.txt", "new content");
            zip.addText("added.txt", "new file");
            zip.close();
        }

        hash<ZipDiffResult> result = ZipFile::diff(path1, path2);

        assertEq(1, result.added_count, "diff: 1 added");
        assertEq(1, result.deleted_count, "diff: 1 deleted");
        assertEq(1, result.modified_count, "diff: 1 modified");
        assertEq(1, result.unchanged_count, "diff: 1 unchanged");

        assertEq("added.txt", result.added[0].name, "diff: added entry name");
        assertEq("deleted.txt", result.deleted[0].name, "diff: deleted entry name");
        assertEq("modified.txt", result.modified[0].old.name, "diff: modified entry name");
        assertEq("same.txt", result.unchanged[0].name, "diff: unchanged entry name");

        # Test identical archives
        hash<ZipDiffResult> same = ZipFile::diff(path1, path1);
        assertEq(0, same.added_count, "diff same: 0 added");
        assertEq(0, same.deleted_count, "diff same: 0 deleted");
        assertEq(0, same.modified_count, "diff same: 0 modified");
        assertEq(3, same.unchanged_count, "diff same: all unchanged");
    }

    recompressTest() {
        string zipPath = testDir + "/recompress_test.zip";

        # Create archive with deflate
        {
            ZipFile zip(zipPath, "w");
            zip.addText("file1.txt", "Hello World");
            zip.addText("file2.txt", "Another file with some content for compression testing");
            zip.addDirectory("dir/");
            zip.close();
        }

        # Verify entries use deflate
        {
            ZipFile zip(zipPath, "r");
            list<hash<ZipEntryInfo>> entries = zip.entries();
            foreach hash<ZipEntryInfo> e in (entries) {
                if (!e.is_directory) {
                    assertEq(ZIP_CM_DEFLATE, e.compression_method,
                        "original uses deflate: " + e.name);
                }
            }
            zip.close();
        }

        # Recompress to store (no compression)
        hash<auto> result = ZipFile::recompress(zipPath, ZIP_CM_STORE);
        assertEq(True, result.success, "recompress: success");
        assertEq(3, result.entry_count, "recompress: 3 entries");

        # Verify entries now use store
        {
            ZipFile zip(zipPath, "r");
            list<hash<ZipEntryInfo>> entries = zip.entries();
            foreach hash<ZipEntryInfo> e in (entries) {
                if (!e.is_directory) {
                    assertEq(ZIP_CM_STORE, e.compression_method,
                        "recompressed uses store: " + e.name);
                }
            }
            # Verify content preserved
            assertEq("Hello World", zip.readText("file1.txt"),
                "recompress: content preserved");
            zip.close();
        }
    }
}
